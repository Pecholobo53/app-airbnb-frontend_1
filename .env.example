# ============================================================
# VoyagerAuMaroc — Variables de entorno del FRONTEND
# ============================================================
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# ─── Backend REST API ────────────────────────────────────────
# URL base del backend SIN trailing slash y SIN /api.
# · Desarrollo local:  http://localhost:3000
# · Producción:        https://api.voyageraumaroc.net
#
# ⚠️  NEXT_PUBLIC_* → visible en el browser.
# ⚠️  NO incluir /api al final — los servicios lo añaden solos.
NEXT_PUBLIC_API_URL=https://api.voyageraumaroc.net

# ─── Google OAuth ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Crea credenciales OAuth 2.0 → "Web application"
# Añade http://localhost:3001 (dev) y https://www.voyageraumaroc.net (prod)
# como "Authorized JavaScript origins" y "Authorized redirect URIs".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<tu-google-client-id>.apps.googleusercontent.com

# ─── Stripe ───────────────────────────────────────────────────
# Clave PÚBLICA de Stripe (pk_test_* en test, pk_live_* en prod).
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<tu-clave-publica>

# ─── (Opcional) Analytics / Monitoring ───────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
